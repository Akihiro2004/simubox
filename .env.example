# SimuBox environment. Copy to .env.local for local development:
#   cp .env.example .env.local
# .env.local is gitignored. Never commit real keys.
# The app runs with everything empty: lessons then come from the built-in
# offline demos and there is no sign-in or saving.

# ---------------------------------------------------------------------------
# Gemini: writes every full lesson, and does the read-aloud voices.
# Secret, server only. Pick ONE of the two options.
# ---------------------------------------------------------------------------

# Option A (local dev): AI Studio key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Option B (Cloud Run): Vertex AI with the service's own identity, no key.
# scripts/deploy.ps1 sets these for you.
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=simubox-b847d
# GOOGLE_CLOUD_LOCATION=global

# Lesson model and voice model (defaults shown).
GEMINI_MODEL=gemini-3.8-flash
# GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts

# How hard Gemini thinks before writing a full lesson: low | medium | high.
# Higher = slower first step. Default medium.
# AI_LESSON_THINKING=medium

# Give up on a lesson after this long (ms). Default 70000.
# AI_TIMEOUT_MS=70000

# ---------------------------------------------------------------------------
# DeepSeek (optional): cheaper model for the mechanical plan calls.
# Secret, server only. Without a key, Gemini does everything.
# ---------------------------------------------------------------------------
# Key from https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
# Official latest-Flash alias (V4.1-Flash-1017 as of 2026-10-17).
# https://api-docs.deepseek.com/updates/
DEEPSEEK_MODEL=deepseek-flash
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# Which model writes each kind of plan: gemini | deepseek.
#   lesson = a new question (full lesson)     default gemini
#   quick  = a tweak to the current scene     default deepseek (if its key is set)
#   repair = fixing commands a plan got wrong default deepseek (if its key is set)
# DeepSeek always runs with low thinking (reasoning_effort "low").
# If DeepSeek fails, the call falls back to Gemini automatically.
# AI_LESSON_PROVIDER=gemini
# AI_QUICK_PROVIDER=deepseek
# AI_REPAIR_PROVIDER=deepseek

# ---------------------------------------------------------------------------
# Speechify (optional): can voice English lines with Simba 3.2. Faster and
# cheaper than Gemini TTS and has no 100-requests-a-day cap. Each student
# picks the English voice in Settings (Google Gemini by default); Indonesian
# lines always use Gemini (Simba 3.2 is English only). If the picked engine
# fails or hits its limit, the line falls back to the other one, then the
# browser's voice.
# Secret, server only. Key from https://platform.speechify.ai (API keys).
# ---------------------------------------------------------------------------
SPEECHIFY_API_KEY=
# SPEECHIFY_MODEL=simba-3.2
# Override any role's voice (robot, kid, teacher, scientist, astronaut, narrator):
# SPEECHIFY_VOICES={"kid":"harper_32"}

# ---------------------------------------------------------------------------
# Firebase: Google sign-in and saved experiments (Firestore).
# Public web-app identifiers, not secrets. Find them in the Firebase console:
# Project settings > Your apps > Web app > SDK setup and configuration.
# Served to the browser at runtime by /api/config. Leave empty for guest-only.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Project the server checks sign-in tokens against (defaults to the one above).
# FIREBASE_PROJECT_ID=

# Firestore rules live in firestore.rules. Deploy them with:
#   firebase deploy --only firestore:rules,firestore:indexes

# ---------------------------------------------------------------------------
# Credits ledger (balances, purchases). Production always uses Firestore
# (credits/{account}), which works on serverless hosts. On Google Cloud the
# runtime identity is used. On other hosts (Vercel, AWS Lambda...) paste the
# Firebase service-account key JSON here as one line. Secret, server only.
# ---------------------------------------------------------------------------
# FIREBASE_SERVICE_ACCOUNT=
# Force a store: firestore | file. `file` (.data/credits.json) is for one
# local server only, e.g. testing `npm start` without Firestore access.
# CREDITS_STORE=
