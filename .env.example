# Copy to .env.local for local development. Never commit real values.

# --- Gemini (server only, secret) ---------------------------------------
# Option A: Gemini API key from https://aistudio.google.com/apikey (local dev)
GEMINI_API_KEY=
# Option B (Cloud Run): use Vertex AI with the service account, no key needed
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_CLOUD_LOCATION=global
GEMINI_MODEL=gemini-3.8-flash
# AI_TIMEOUT_MS=45000

# --- Firebase web config (public identifiers, not secrets) ---------------
# Read at runtime by /api/config. Leave empty to run guest-only.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
