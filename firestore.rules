rules_version = '2';

// Each student can only read and write their own saved experiments.
// Everything else is closed. (The server's Admin SDK bypasses these rules,
// but SimuBox only uses it to verify sign-in tokens.)
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/experiments/{expId} {
      function isOwner() {
        return request.auth != null && request.auth.uid == uid;
      }
      function validExperiment() {
        let d = request.resource.data;
        return d.keys().hasOnly(['id', 'title', 'world', 'updatedAt', 'updatedAtMs', 'scene', 'messages', 'plan', 'version'])
          && d.id == expId
          && d.title is string && d.title.size() > 0 && d.title.size() <= 80
          && d.world in ['bedroom', 'court', 'lab', 'park', 'stage', 'space', 'ocean', 'math', 'globe', 'workshop', 'optics']
          && d.updatedAtMs is int
          && d.version == 1
          && d.messages is list && d.messages.size() <= 40
          && d.scene is map;
      }
      allow read, delete: if isOwner();
      allow create, update: if isOwner() && validExperiment();
    }
    // Remembers that the student finished the welcome flow, and what they chose in it.
    match /users/{uid}/meta/{docId} {
      function isSelf() {
        return request.auth != null && request.auth.uid == uid;
      }
      function validProfile() {
        let d = request.resource.data;
        return docId == 'profile'
          && d.keys().hasOnly(['onboardedAt', 'gradeBand', 'language', 'voice'])
          && d.onboardedAt is int
          && (!('gradeBand' in d) || d.gradeBand in ['elementary', 'middle', 'high'])
          && (!('language' in d) || d.language in ['auto', 'en', 'id'])
          && (!('voice' in d) || d.voice is bool);
      }
      allow read: if isSelf();
      allow create, update: if isSelf() && validProfile();
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
